# Copy this to secrets.toml locally; never commit the real secrets.toml.
# On Community Cloud, enter values in the app's Secrets settings.
APP_ENV = "public"
LIVE_AI_ENABLED = false
LLM_MODEL = ""
LLM_BASE_URL = "https://router.huggingface.co/v1"
LLM_API_KEY = ""

# Public live AI requires a durable Redis REST quota store (e.g. Upstash).
QUOTA_REDIS_URL = ""
QUOTA_REDIS_TOKEN = ""
MAX_DAILY_CALLS = 100
MAX_SESSION_CALLS = 30
MAX_OUTPUT_TOKENS = 1200
MAX_PROMPT_CHARS = 24000
SOURCE_REPOSITORY_URL = ""
